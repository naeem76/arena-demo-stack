{
  "name": "arena-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prestart": "node scripts/write-config.mjs",
    "start": "ng serve --host 0.0.0.0",
    "prebuild": "node scripts/write-config.mjs && npm run generate:api",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:e2e": "playwright test",
    "test:e2e:types": "tsc -p e2e/tsconfig.json",
    "format": "prettier --write \"src/**/*.{ts,html,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css}\"",
    "generate:api": "node scripts/generate-api.mjs",
    "update:api": "node scripts/update-contract.mjs && npm run generate:api"
  },
  "private": true,
  "engines": { "node": ">=24.15.0 <25" },
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/common": "22.1.6",
    "@angular/compiler": "22.1.6",
    "@angular/core": "22.1.6",
    "@angular/forms": "22.1.6",
    "@angular/platform-browser": "22.1.6",
    "@angular/router": "22.1.6",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/outfit": "5.3.0",
    "angular-oauth2-oidc": "22.0.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "22.1.6",
    "@angular/cli": "22.1.6",
    "@angular/compiler-cli": "22.1.6",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.5",
    "daisyui": "5.7.38",
    "jsdom": "^28.0.0",
    "ng-openapi-gen": "1.0.5",
    "postcss": "8.5.28",
    "prettier": "^3.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
